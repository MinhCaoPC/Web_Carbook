# ================= CARBOOK backend =================
# Sao chép file này thành .env rồi điền giá trị.

PORT=5050

# Khóa ký token đăng nhập (JWT). Chuỗi ngẫu nhiên dài >= 32 ký tự, KHÔNG chia sẻ.
JWT_SECRET=doi-thanh-chuoi-ngau-nhien-that-dai
JWT_EXPIRES_IN=7d

# ----- Đăng nhập Google -----
# Google Cloud Console -> APIs & Services -> Credentials -> OAuth client ID loại "Web application",
# thêm http://localhost:5050 vào "Authorized JavaScript origins". Bỏ trống = ẩn nút Google.
GOOGLE_CLIENT_ID=

# ----- Quên mật khẩu: gửi mã OTP qua Gmail -----
# GMAIL_APP_PASSWORD là App Password 16 ký tự tạo ở myaccount.google.com/apppasswords
# (tài khoản Gmail phải bật xác minh 2 bước), KHÔNG phải mật khẩu Gmail thường.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# development: nếu chưa cấu hình Gmail / gửi lỗi thì in mã OTP ra cửa sổ backend (chỉ để demo)
# production: tắt đường vòng đó
NODE_ENV=development

# ----- Dữ liệu off-chain (tài khoản, thông tin chuyến, thông tin hành khách) -----
# firebase : dùng Firestore, cần file backend/serviceAccountKey.json
# tep      : lưu file JSON trong backend/du-lieu/ — không tốn lượt truy cập Firebase (cần sẵn du-lieu/danh-muc.json)
NOI_LUU_DU_LIEU=firebase
# Danh mục chuyến xe đọc Firebase 1 lần rồi lưu ra du-lieu/danh-muc.json; quá số giờ này mới đọc lại
SO_GIO_LAM_MOI_DANH_MUC=24
# Số ngày bán vé (hôm nay + 3 ngày) và số chuyến tối đa mỗi tuyến/ngày
SO_NGAY_BAN_VE=4
SO_CHUYEN_MOI_TUYEN=2

# ----- Blockchain -----
# localhost : mạng ảo trên máy (npm run mang-ao trong thư mục blockchain)
# sepolia   : mạng thử nghiệm Ethereum Sepolia
MANG_BLOCKCHAIN=localhost
# RPC của mạng ảo
RPC_URL=http://127.0.0.1:8545
# RPC Sepolia (bỏ trống = https://ethereum-sepolia-rpc.publicnode.com). Chạy Sepolia: npm run start:sepolia
RPC_URL_SEPOLIA=
# Tỷ giá DEMO đổi giá vé VNĐ -> ETH (1 ETH = 100.000.000đ => vé 240.000đ = 0,0024 ETH)
TY_GIA_VND_MOI_ETH=100000000
# Tùy chọn cho `npm run mo-ban-chuyen:sepolia`: bỏ trống thì dùng SEPOLIA_PRIVATE_KEY trong blockchain/.env (KHÔNG commit)
KHOA_CHU_HOP_DONG=
