PORT=5050

# Gmail dùng để gửi mã OTP quên mật khẩu
# GMAIL_APP_PASSWORD là App Password 16 ký tự tạo tại myaccount.google.com/apppasswords
# (yêu cầu tài khoản Gmail đã bật xác minh 2 bước), không phải mật khẩu Gmail thường.
GMAIL_USER=your_email@gmail.com
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx

# VNPAY Sandbox (đăng ký tại https://sandbox.vnpayment.vn/devreg)
VNP_TMN_CODE=your_tmn_code
VNP_HASH_SECRET=your_hash_secret
VNP_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNP_RETURN_URL=http://10.0.2.2:5050/api/token/deposit/vnpay-return

# ===== Vé NFT (blockchain chỉ dùng cho vé; ví tiền là ví nội Firestore) =====
# Bỏ trống các biến dưới đây = tắt NFT, đặt vé/thanh toán/ví vẫn chạy bình thường.
# RPC Ethereum Sepolia + khóa relayer. Có thể đặt ở ĐÂY hoặc ở blockchain/.env (backend tự đọc cả hai).
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/YOUR_KEY
RELAYER_PRIVATE_KEY=0x...
# Địa chỉ hợp đồng sau khi chạy: cd ../blockchain && npx hardhat run scripts/deploy.ts --network sepolia
TICKET_NFT_ADDRESS=
TICKET_MARKET_ADDRESS=
# Bí mật suy ra địa chỉ chủ vé NFT từ tài khoản (>=16 ký tự; mặc định dùng JWT_SECRET). KHÔNG đổi sau khi đã mint vé.
NFT_ADDRESS_SECRET=
# Luật chợ vé (khớp lúc deploy): hoa hồng bán lại 5%, giá bán lại tối đa 110% giá gốc
ROYALTY_BPS=500
MAX_MARKUP_BPS=11000
# Miền Tây: số chuyến tối đa mỗi tuyến/ngày (mặc định 2)
MEKONG_TRIPS_PER_ROUTE=2
# Google Sign-In: Web OAuth client ID (có thể nhiều ID, ngăn cách bằng dấu phẩy)
GOOGLE_CLIENT_ID=

# Khóa ký token đăng nhập (JWT HS256) — bắt buộc ở production, tối thiểu 32 ký tự (tạo: openssl rand -hex 48)
JWT_SECRET=your_long_random_secret
# Thời hạn token (mặc định 12h)
JWT_EXPIRES_IN=12h
# production: tắt mọi đường vòng dành cho demo (vd: in OTP ra console khi gửi mail lỗi, route mock-create)
NODE_ENV=development
